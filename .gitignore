# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/

# Data and Stores (Keep directories via .gitkeep)
# Active runtime ingestion target (ephemeral)
data/runemark_raw/*
!data/runemark_raw/.gitkeep
# Normalized / processed documents generated by ingestion pipeline
data/runemark_processed/*
!data/runemark_processed/.gitkeep
# Local vector store embeddings and indices
data/vector_store/*
!data/vector_store/.gitkeep
# Track baseline dev_pack_E5 for tests/CI, ignore other local test packs
data/test_packs/*
!data/test_packs/.gitkeep
!data/test_packs/dev_pack_E5/

# Persistent Case Artifacts (Track benchmark & saved case outputs, ignore temp caches)
saved_cases/*
!saved_cases/.gitkeep
!saved_cases/*.json

# Local Proposal Docs (CONTEXT_UPDATED.md is tracked as the team design handoff)
PROPOSED_FILE_STRUCTURE.md

# Database & Runtime Logs
*.sqlite
*.db
*.log

# Environment and Secrets
.env
.env.local
*.pem
*.key

# Frontend / Node
node_modules/
dist/
build/

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Test and Coverage
.pytest_cache/
.coverage
htmlcov/
